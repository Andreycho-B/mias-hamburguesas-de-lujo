# ==============================================================================
# Cloudflare Pages Custom Headers (_headers)
# Mías Hamburguesas de Lujo - Optimización de Caché y Rendimiento Instantáneo
# ==============================================================================

# 1. Imágenes estáticas y optimizadas WebP/PNG/SVG (Cache inmutable de 1 año)
/imagenes/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff

/*.webp
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/*.png
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/*.svg
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# 2. Bundles JavaScript y CSS con hash generado por Vite
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# 3. PWA Web Manifest y Favicons
/manifest.webmanifest
  Cache-Control: public, max-age=86400
  Content-Type: application/manifest+json; charset=utf-8

# 4. Service Worker (Siempre debe validarse con el servidor para aplicar actualizaciones)
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/javascript; charset=utf-8

# 5. Documento HTML raíz (Permite actualizaciones inmediatas al desplegar en Cloudflare)
/index.html
  Cache-Control: public, max-age=0, must-revalidate
