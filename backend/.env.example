# Entorno de Ejecución Backend Go
PORT=8080
FRONTEND_URL=http://localhost:5173

# Modo de Entorno: "development" o "production"
# En production se endurecen CORS, se deshabilitan orígenes locales y se exige HTTPS
ENV_MODE=development

# Base de Datos PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mias_db?sslmode=disable

# Pool de Conexiones: máximo de conexiones simultáneas al motor PostgreSQL
# Valor recomendado para >500 comensales: 100
DB_MAX_CONNS=25

# Clave Secreta para Firmado de Tokens JWT (Generar una cadena aleatoria en producción)
JWT_SECRET=mias-super-secret-key-2026-banking-grade-zero-trust

# Origen permitido explícito para CORS en producción (ej. https://miashamburguesas.com)
# En development se permiten orígenes locales automáticamente
CORS_ALLOWED_ORIGIN=

# Credenciales de Google OAuth 2.0 (Para validación server-side)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
