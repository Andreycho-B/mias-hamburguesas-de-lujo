# Entorno de Ejecución Backend Go
PORT=8080
FRONTEND_URL=http://localhost:5173

# Base de Datos PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mias_db?sslmode=disable

# Clave Secreta para Firmado de Tokens JWT (Generar una cadena aleatoria en producción)
JWT_SECRET=mias-super-secret-key-2026-banking-grade-zero-trust

# Credenciales de Google OAuth 2.0 (Para validación server-side)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
